rules_version = '2';

// O frontend não acessa o Firestore diretamente: todo acesso passa pela API (Firebase Admin SDK,
// que ignora estas regras). Por isso o acesso pelos SDKs de cliente é totalmente bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
